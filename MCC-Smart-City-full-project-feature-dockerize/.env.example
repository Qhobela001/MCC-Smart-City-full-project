# ============================================================
# MCC Smart City - Environment Template
# ============================================================
# Copy to .env and replace placeholder values.
# Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=mcc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend / JWT
SECRET_KEY=change-me-to-a-secure-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Super Administrator
SUPERADMIN_NAME=MCC Super Administrator
SUPERADMIN_EMAIL=admin@mcc.org.ls
SUPERADMIN_PASSWORD=change-me

# Live Monitoring / MediaMTX
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
LIVE_STREAM_TOKEN_SECRET=change-me-to-a-secure-random-value
LIVE_STREAM_TOKEN_TTL_SECONDS=300

# Camera gateway authentication
CAMERA_GATEWAY_SHARED_KEY=change-me-to-a-secure-random-value

# AI worker machine authentication and audit attribution
AI_WORKER_SHARED_KEY=change-me-to-a-separate-random-value
AI_INGEST_ACTOR_EMAIL=admin@mcc.org.ls

# Stage AI-1 controlled inference worker
# The verified weight file is mounted locally and is never committed to Git.
AI_MODEL_PATH=./ai_worker/model_weights/mcc_detector_v1.pt
AI_MODEL_SHA256=845026048d3bb44831b069cbc36e189bb0fc0bbcff4f4445b8fcab382359d9af
AI_MODEL_NAME=mcc_detector_v1
AI_MODEL_VERSION=v1
AI_CONFIDENCE=0.25
AI_IMAGE_SIZE=640
AI_VIDEO_SAMPLE_SECONDS=1.0
AI_REQUEST_ATTEMPTS=3

# Stage AI-2 live observation (opt-in profile; detections remain test-only)
AI_LIVE_CAMERA_IDENTIFIER=MCC-CAM-001
AI_LIVE_SAMPLE_SECONDS=2.0
AI_LIVE_RECONNECT_MIN_SECONDS=2.0
AI_LIVE_RECONNECT_MAX_SECONDS=30.0
AI_LIVE_TOKEN_REFRESH_SECONDS=30.0

# MediaMTX publisher account
LIVE_STREAM_PUBLISH_USERNAME=mcc-camera-gateway
LIVE_STREAM_PUBLISH_PASSWORD=change-me

# Encrypted camera credential vault
CAMERA_CREDENTIAL_MASTER_KEY=replace-with-valid-stable-master-key

# V380 defaults
V380_DEFAULT_USERNAME=admin
V380_DEFAULT_PASSWORD=
V380_DEFAULT_FPS=12
V380_LIVE_SOCKET_TIMEOUT=2
V380_LIVE_IDLE_TIMEOUT=20

# Gateway behavior
CAMERA_REGISTRY_POLL_SECONDS=10
CAMERA_RECONNECT_SECONDS=5
FFMPEG_LOG_LEVEL=warning
# Stage AI-3 test-only temporal event qualification
AI_QUALIFICATION_ENABLED=true
AI_QUALIFICATION_MIN_HITS=3
AI_QUALIFICATION_MAX_GAP_SECONDS=8.0
AI_QUALIFICATION_CONTEXT_WINDOW_SECONDS=10.0
AI_QUALIFICATION_COOLDOWN_SECONDS=60.0

# Stage AI-4 test-only evidence capture
AI_EVIDENCE_ENABLED=true
AI_EVIDENCE_PRE_SECONDS=6.0
AI_EVIDENCE_POST_SECONDS=6.0
AI_EVIDENCE_SAMPLE_SECONDS=0.5
AI_EVIDENCE_RETENTION_HOURS=24.0
AI_EVIDENCE_MAX_STORAGE_MB=512
