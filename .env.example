# Example environment variables for MCC Smart City
# Copy this file to `.env` and fill in real values before running.

# Postgres
POSTGRES_DB=mcc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# App / Security
SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS / Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superadmin credentials (change in production)
SUPERADMIN_NAME=MCC Super Administrator
SUPERADMIN_EMAIL=admin@mcc.org.ls
SUPERADMIN_PASSWORD=ChangeMe123!
